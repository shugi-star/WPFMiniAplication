<Window x:Class="WPFMiniAplication.AddCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFMiniAplication"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Category"/>
            <ComboBox x:Name="CategoryBox"/>

            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionBox"/>

            <TextBlock Text="Address"/>
            <TextBox x:Name="AddressBox"/>

            <TextBlock Text="Latitude"/>
            <TextBox x:Name="LatitudeBox"/>

            <TextBlock Text="Longitude"/>
            <TextBox x:Name="LongitudeBox"/>

            <TextBlock Text="Open Date"/>
            <DatePicker x:Name="OpenDatePicker"/>

            <TextBlock Text="Target Date"/>
            <DatePicker x:Name="TargetDatePicker"/>

            <TextBlock Text="Volunteer Id"/>
            <TextBox x:Name="VolunteerIdBox"/>

            <Button Content="Save"
                    Margin="0,20,0,0"
                    Click="Save_Click"
                    Height="30"/>

        </StackPanel>
    </ScrollViewer>
</Window>
