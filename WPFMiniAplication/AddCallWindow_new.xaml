<Page x:Class="WPFMiniAplication.AddCallWindow_new"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFMiniAplication"
        mc:Ignorable="d"
        Title="AddCallWindow_new" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <Label HorizontalAlignment="Center" FontSize="35">Create New Call:</Label>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" FontSize="20" Content="Category:"/>

            <ComboBox Grid.Row="0"
       Grid.Column="1"
       x:Name="cmbCategory"
       DisplayMemberPath="CategoryName"
       SelectedValuePath="IdCategory"
       SelectionChanged="cmbCategory_SelectionChanged"/>

            <Label Grid.Row="1" Grid.Column="0" FontSize="20" Content="Description:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDescription"/>

            <Label Grid.Row="2" Grid.Column="0" FontSize="20" Content="Address:"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAddress"/>

          
            <Button Grid.Row="9" Grid.ColumnSpan="2"
        x:Name="btnCreateCall"
        Content="Click to create!!!"
        Width="220"
        Height="40"
        HorizontalAlignment="Center"
        Click="saveNewCall"/>

            <Button Grid.Row="9" Grid.ColumnSpan="2"
x:Name="btnGoToCreateVolunteer"
Content="To create volunteer"
Width="220"
Height="40"
HorizontalAlignment="Left"
Click="GoToCreateVolunteer" Margin="132,70,0,-60"/>
        </Grid>


    </Grid>
</Page>
