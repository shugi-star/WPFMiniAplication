<Page x:Class="WPFMiniAplication.login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFMiniAplication"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="login">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Label Content="הכנס תעודת זהות" Margin="20" HorizontalAlignment="Center"/>
            <TextBox x:Name="txtId"  Width="200" Margin="-10"/>
            <Label Content="הכנס סיסמא" Margin="20" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="txtPass" PasswordChar="%"  Width="200" Margin="-10"/>
            <Button x:Name="btnLogin" HorizontalAlignment="Center" Margin="50" Width="100" Height="20" Content="היכנס למערכת" Click="Login"/>

        </StackPanel>
    </Grid>
</Page>
